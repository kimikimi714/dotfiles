#!/usr/bin/env bash
# -----------------------------------------------------------------------------
# Global Git commit-msg hook
# Enforces context-rich commit messages so AI agents and collaborators can
# understand the background and reasoning behind changes.
# -----------------------------------------------------------------------------

set -eo pipefail

# 1. Fallback if python3 is not installed or not in PATH
if ! command -v python3 >/dev/null 2>&1; then
    echo -e "\033[1;33m[WARN: commit-msg hook]\033[0m python3 was not found in PATH." >&2
    echo "Skipping commit message validation so your workflow is not blocked." >&2
    echo "To enable full validation, please set up Python via mise: 'mise use -g python@latest'" >&2
    exit 0
fi

# 2. Execute validation using python3
python3 - "$1" << 'EOF'
import sys

def validate(commit_file):
    try:
        with open(commit_file, "r", encoding="utf-8") as f:
            content = f.read()
    except Exception as e:
        print(f"\033[1;33m[WARN: commit-msg hook]\033[0m Failed to read commit message: {e}", file=sys.stderr)
        print("Bypassing validation to prevent blocking commit.", file=sys.stderr)
        sys.exit(0)

    # Strip comments and trailing blank lines
    lines = [line for line in content.splitlines() if not line.strip().startswith("#")]
    while lines and not lines[-1].strip():
        lines.pop()

    if not lines:
        print("\n\033[0;31m❌ [COMMIT-MSG HOOK REJECTED]\033[0m Commit message is empty.", file=sys.stderr)
        sys.exit(1)

    first_line = lines[0].strip()

    # Skip automated git operations (merge, revert, fixup, squash, initial commit)
    if any(first_line.startswith(p) for p in ("Merge ", "Revert ", "fixup! ", "squash! ")):
        sys.exit(0)

    # 1. Validate summary presence
    if not first_line:
        print("\n\033[0;31m❌ [COMMIT-MSG HOOK REJECTED]\033[0m Commit header (first line) is missing.", file=sys.stderr)
        sys.exit(1)

    # 2. Require contextual body for non-trivial commits (prevent 1-line commits)
    if len(lines) == 1:
        print("\n\033[0;31m❌ [COMMIT-MSG HOOK REJECTED]\033[0m 1-line commit message detected.", file=sys.stderr)
        print("To ensure AI agents and collaborators can reconstruct context from git history,")
        print("please include a blank line and a 'Why / Context' explanation in the body.\n", file=sys.stderr)
        print("Recommended format:", file=sys.stderr)
        print("  <Summary of change>", file=sys.stderr)
        print("  ", file=sys.stderr)
        print("  [Why / Context]", file=sys.stderr)
        print("  Detailed explanation of why this change was needed...\n", file=sys.stderr)
        print("  [Details] (Optional)", file=sys.stderr)
        print("  - Specific change details...\n", file=sys.stderr)
        print("(Tip: In emergency situations, you can bypass hooks using 'git commit --no-verify')", file=sys.stderr)
        print("-" * 60, file=sys.stderr)
        sys.exit(1)

    # 3. Check that line 2 is blank (Git convention)
    if len(lines) >= 2 and lines[1].strip() != "":
        print("\n\033[0;31m❌ [COMMIT-MSG HOOK REJECTED]\033[0m The second line must be blank.", file=sys.stderr)
        print("Please separate the summary and the body with an empty line.", file=sys.stderr)
        sys.exit(1)

    sys.exit(0)

if __name__ == "__main__":
    if len(sys.argv) > 1:
        validate(sys.argv[1])
EOF
