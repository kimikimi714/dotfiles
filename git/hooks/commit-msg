#!/usr/bin/env bash
# -----------------------------------------------------------------------------
# Global Git commit-msg hook
# Enforces structured, context-rich commit messages for AI agents and humans.
# -----------------------------------------------------------------------------

set -eo pipefail

# 1. Fallback if python3 is not installed or not in PATH
if ! command -v python3 >/dev/null 2>&1; then
    echo -e "\033[1;33m[WARN: commit-msg hook]\033[0m python3 was not found in PATH." >&2
    echo "Skipping commit message validation so your workflow is not blocked." >&2
    echo "To enable full validation, please set up Python via mise: 'mise use -g python@latest'" >&2
    exit 0
fi

# 2. Execute validation using python3
python3 - "$1" << 'EOF'
import re
import sys

ALLOWED_EMOJIS = [
    ":tada:", ":+1:", ":shower:", ":new:", ":bug:", ":recycle:", ":memo:", ":up:",
    "🎉", "👍", "🚿", "🆕", "🐛", "♻️", "📝", "🆙"
]

def validate(commit_file):
    try:
        with open(commit_file, "r", encoding="utf-8") as f:
            content = f.read()
    except Exception as e:
        print(f"\033[1;33m[WARN: commit-msg hook]\033[0m Failed to read commit message: {e}", file=sys.stderr)
        print("Bypassing validation to prevent blocking commit.", file=sys.stderr)
        sys.exit(0)

    # Strip comments and trailing blank lines
    lines = [line for line in content.splitlines() if not line.strip().startswith("#")]
    while lines and not lines[-1].strip():
        lines.pop()

    if not lines:
        print("\n\033[0;31m❌ [COMMIT-MSG HOOK REJECTED]\033[0m Commit message is empty.", file=sys.stderr)
        sys.exit(1)

    first_line = lines[0].strip()

    # Skip automated git operations (merge, revert, fixup, squash)
    if any(first_line.startswith(p) for p in ("Merge ", "Revert ", "fixup! ", "squash! ")):
        sys.exit(0)

    # Validate header emoji
    has_valid_emoji = any(first_line.startswith(e) for e in ALLOWED_EMOJIS)
    if not has_valid_emoji:
        allowed = ", ".join(ALLOWED_EMOJIS[:8])
        print(f"\n\033[0;31m❌ [COMMIT-MSG HOOK REJECTED]\033[0m Invalid commit header.", file=sys.stderr)
        print(f"The first line must start with one of the allowed emojis:\n  {allowed} ...", file=sys.stderr)
        print(f"Your header: '{first_line}'", file=sys.stderr)
        print("\n(Tip: In emergency situations, you can bypass hooks using 'git commit --no-verify')", file=sys.stderr)
        print("-" * 60, file=sys.stderr)
        sys.exit(1)

    # Check for summary text
    header_without_emoji = first_line
    for emoji in ALLOWED_EMOJIS:
        if header_without_emoji.startswith(emoji):
            header_without_emoji = header_without_emoji[len(emoji):].strip()
            break

    if not header_without_emoji:
        print("\n\033[0;31m❌ [COMMIT-MSG HOOK REJECTED]\033[0m Missing summary text after emoji.", file=sys.stderr)
        print("Example: :+1: Add documentation for new features", file=sys.stderr)
        sys.exit(1)

    # Require contextual body for non-trivial commits (at least 2 non-empty lines)
    if len(lines) == 1:
        print("\n\033[0;31m❌ [COMMIT-MSG HOOK REJECTED]\033[0m Commit message is too brief (1-line commit).", file=sys.stderr)
        print("To preserve context for AI agents and collaborators, please include Why/Context in the body:\n", file=sys.stderr)
        print("  <emoji> <Summary (What)>\n", file=sys.stderr)
        print("  [Why / Context]", file=sys.stderr)
        print("  Explain why this change was needed...\n", file=sys.stderr)
        print("(Tip: In emergency situations, you can bypass hooks using 'git commit --no-verify')", file=sys.stderr)
        print("-" * 60, file=sys.stderr)
        sys.exit(1)

    # Check that line 2 is blank (Git convention)
    if len(lines) >= 2 and lines[1].strip() != "":
        print("\n\033[0;31m❌ [COMMIT-MSG HOOK REJECTED]\033[0m The second line must be blank.", file=sys.stderr)
        sys.exit(1)

    sys.exit(0)

if __name__ == "__main__":
    if len(sys.argv) > 1:
        validate(sys.argv[1])
EOF
